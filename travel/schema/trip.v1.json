        },
        "placeId": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     },
     "dataset": {
      "type": [
       "string",
       "null"
      ]
     },
     "rules": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "checklists": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "items": {
      "type": "array",
