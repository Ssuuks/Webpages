      "string",
      "null"
     ]
    },
    "contacts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/contact"
     }
    },
    "scenarios": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "title"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "desc": {
        "type": [
         "string",
         "null"
        ]
       },
       "steps": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "contacts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/contact"
   }
  },
  "budget": {
   "type": "object",
   "properties": {
    "planned": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "cat": {
        "type": "string"
       },
       "amount": {
        "type": "number"
       },
       "currency": {
        "type": [
         "string",
